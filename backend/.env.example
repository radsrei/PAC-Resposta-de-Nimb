# Copie para backend/.env e ajuste. Todas as variáveis são opcionais.

API_HOST=0.0.0.0
API_PORT=8000

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Banco local (SQLite) com conexões LLM e histórico das sessões
# DATABASE_PATH=./data/nimb.db

# Tempo máximo (s) aguardando a LLM e nº de mensagens anteriores enviadas como contexto
LLM_TIMEOUT=120
HISTORY_LIMIT=10

# Conexão LLM padrão (opcional). Se nenhuma conexão estiver cadastrada,
# a API cria uma a partir daqui ao subir. Também é possível cadastrar pela tela.
# Provedores: openai | anthropic | gemini | deepseek | ollama | openai_compatible
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------
# Login e segurança
# ----------------------------------------------------------------------
# Chave para criptografar as API keys das LLMs no banco. Se vazia, uma chave
# é gerada em data/secret.key. Em produção defina um valor longo e aleatório.
# APP_SECRET_KEY=

# Login com Google: Client ID OAuth (tipo "Aplicativo da Web") do Google Cloud.
# Vazio = botão do Google desativado.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Cookie de sessão. Em produção (HTTPS) use COOKIE_SECURE=true
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
REMEMBER_ME_DAYS=7

# Cadastro e administradores
REGISTRATION_ENABLED=true
FIRST_USER_IS_ADMIN=true
# ADMIN_EMAILS=voce@exemplo.com,outra@exemplo.com

# Senha básica e fixa aplicada nos resets (troca obrigatória no próximo login)
DEFAULT_RESET_PASSWORD=Nimb@12345
RESET_TOKEN_TTL_MINUTES=30

# Proteção contra força bruta
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20

# Swagger em /docs (desative em produção)
ENABLE_DOCS=true

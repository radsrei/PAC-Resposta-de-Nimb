# Copie para deploy/.env no servidor. Ver deploy_aws.md e cloudflare_dominio.md.

# ---------------------------------------------------------------------------
# Modo A: sem domínio (teste pelo túnel SSH, login em http://localhost:8080)
# ---------------------------------------------------------------------------
SITE_ADDRESS=:80
COMPOSE_PROFILES=
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Modo Cloudflare: respostas-nimb.com.br pelo Cloudflare Tunnel (recomendado)
# O HTTPS fica no Cloudflare; o Caddy segue em HTTP dentro do servidor.
# ---------------------------------------------------------------------------
# SITE_ADDRESS=:80
# COMPOSE_PROFILES=cloudflare
# TUNNEL_TOKEN=<token do túnel: Cloudflare Zero Trust → Networks → Tunnels>

# ---------------------------------------------------------------------------
# Modo B sem Cloudflare: HTTPS emitido pelo próprio Caddy (portas 80/443 abertas)
# ---------------------------------------------------------------------------
# SITE_ADDRESS=respostas-nimb.com.br

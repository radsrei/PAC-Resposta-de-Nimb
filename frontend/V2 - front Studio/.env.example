# Copie para .env.local se precisar alterar algo. Nenhuma variável é obrigatória.

# Para onde o proxy do Vite encaminha as chamadas /api/* (padrão: http://localhost:8000)
# BACKEND_PROXY_TARGET=http://localhost:8000

# Chamar o backend direto, sem o proxy do Vite (exige CORS liberado no backend).
# Deixe vazio para usar o proxy.
# VITE_BACKEND_URL=http://localhost:8000

# true = roda sem backend, com respostas simuladas (útil só para revisar a tela)
VITE_USE_MOCK=false

# Sons da alucinação de Nimb (opcionais, arquivos em public/sounds/). Vazio = sem som.
VITE_SOUND_HALLUCINATION_THINKING=
VITE_SOUND_HALLUCINATION_REVEAL=

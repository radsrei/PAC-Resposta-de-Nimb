# Front e API no mesmo endereço (o front chama /api/... por caminho relativo).
#
# SITE_ADDRESS (deploy/.env):
#   :80                       HTTP. Usado no túnel SSH (modo A) e atrás do Cloudflare Tunnel
#                             (respostas-nimb.com.br: o HTTPS fica no Cloudflare)
#   respostas-nimb.com.br     HTTPS automático pelo próprio Caddy (sem Cloudflare)
{
	servers {
		# IP real do usuário: só confia em quem está na rede privada (o container
		# cloudflared, ou o túnel SSH). Desses, lê o CF-Connecting-IP, que o
		# Cloudflare sempre sobrescreve. O X-Forwarded-For NÃO é usado: o
		# Cloudflare mantém o valor enviado pelo cliente, que pode ser forjado.
		# Requisições diretas da internet (IP público) ignoram esses cabeçalhos.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Livros em PDF de até 95 MiB (BOOK_UPLOAD_MAX_MB = 99,6 milhões de bytes) +
	# margem do multipart. Aqui "MB" é decimal: 100MB = 100.000.000 bytes.
	# Não passar de 100 MB: é o limite do plano grátis do Cloudflare.
	request_body {
		max_size 100MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# A API (uvicorn --proxy-headers) recebe só o IP real resolvido acima
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# SPA: qualquer rota que não seja arquivo volta para o index.html
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Configuração do backend. Copie para `backend/.env` e ajuste.
# O `.env` fica fora do Git: nunca versione chaves reais.
# Variáveis comentadas usam o valor padrão indicado.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Swagger em /docs. Padrão false; use true só na sua máquina, nunca no servidor
ENABLE_DOCS=false
# Origens liberadas para o front (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
# Banco SQLite (padrão: backend/data/nimb.db)
# DATABASE_PATH=data/nimb.db

# ---------------------------------------------------------------------------
# Login com Google (único método de acesso)
# ---------------------------------------------------------------------------
# Obrigatório para entrar no sistema. Ver Setup-Front-Tela.md, seção 3.1.
GOOGLE_CLIENT_ID=
# true: a conta é criada no primeiro login com Google
# false: só entram usuários que já existem no banco
REGISTRATION_ENABLED=true
# E-mails administradores, separados por vírgula: viram admin ao criar a conta e a
# cada login. Obrigatório no servidor (o repositório é público: o e-mail fica só no .env)
ADMIN_EMAILS=
# true: a primeira conta criada vira administradora. Mantenha false em produção
FIRST_USER_IS_ADMIN=false
# true: só entram os e-mails da lista de acesso, preenchida pelos administradores
# em Minha conta → E-mails com acesso. Os e-mails de ADMIN_EMAILS entram sempre
ALLOWLIST_ENABLED=true

# ---------------------------------------------------------------------------
# Sessão e segurança
# ---------------------------------------------------------------------------
# Chave para criptografar as API keys das LLMs no banco. Vazia = gerada e
# salva em backend/data/secret.key. Em produção, use um valor longo e aleatório.
APP_SECRET_KEY=
SESSION_COOKIE_NAME=nimb_session
# true em produção com HTTPS
COOKIE_SECURE=false
# Duração da sessão comum (horas) e do "Manter conectado" (dias)
SESSION_TTL_HOURS=8
REMEMBER_ME_DAYS=3
# Requisições por minuto, por IP, na rota de login
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Livros e banco vetorial
# ---------------------------------------------------------------------------
# Pasta com catalog.json e os bancos de cada livro (padrão: vector_store/ na
# raiz do projeto). Gerada por: python -m vector_builder
# VECTOR_STORE_DIR=../vector_store
# Quem gera os embeddings no construtor: sentence-transformers ou ollama
EMBEDDING_PROVIDER=ollama
# Modelo de embeddings. Vazio = padrão do provedor
# (sentence-transformers: BAAI/bge-m3 | ollama: bge-m3)
EMBEDDING_MODEL=
# Servidor do Ollama: embeddings da construção e da pergunta (no Docker: http://ollama:11434)
OLLAMA_URL=http://localhost:11434
# Tempo que o Ollama mantém o modelo na memória: -1 = sempre (evita ~6 s de espera
# depois de um período parado), ou um tempo como 30m / 24h
OLLAMA_KEEP_ALIVE=-1
# Busca nos livros: trechos enviados à LLM e similaridade mínima (0 a 1) para um trecho contar.
# Recalibre com: python -m vector_builder evaluate
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.45
# Busca híbrida: vetores + palavras (BM25) combinados por RRF; peso das palavras e candidatos
RAG_HYBRID=true
RAG_LEXICAL_WEIGHT=0.5
RAG_CANDIDATES=20
# Tamanho máximo do PDF enviado para validação (MB). Cloudflare grátis: até 100 MB
# por requisição, então 95. Mude junto com MAX_UPLOAD_MB do front.
BOOK_UPLOAD_MAX_MB=95
# Validações de livro por minuto, por IP
BOOK_UPLOAD_RATE_PER_MINUTE=5
# Sorteio de tesouro: cópia das tabelas de tesouro e das criaturas de cada livro, refeita
# pela API quando o banco do livro muda (padrão: data/tesouro, ao lado do nimb.db)
# TREASURE_DIR=data/tesouro

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Tempo máximo de espera pela resposta da LLM (segundos). Máximo 90: o Cloudflare
# encerra a requisição em ~100 s (erro 524)
LLM_TIMEOUT=90
# Mensagens anteriores da conversa enviadas como contexto
HISTORY_LIMIT=10

# Medidor de Caos (Baixo, Médio, Alto, Louco), um valor por nível:
# limite (%) da regra de alucinação e voltas de revisão (harness) da resposta.
# Botão "Regra" do front:
# - ligado: (palavras x primo sorteado de 2 a 97 + (dia + mês + ano + hora + minuto + segundo) / C) % 42,
#   com C = voltas + 1 (DIVISOR_OFFSET em app/services/chaos.py). Nimb alucina se a parte decimal
#   for igual ou menor que o limite do nível. A parte decimal só vale 0, 1/C, 2/C...: o limite muda
#   a chance em degraus, e a API avisa no log ao subir se um nível não alucinar mais que o anterior;
# - desligado: depois da busca nos livros, sorteia com o limite do nível como probabilidade.
# Cada volta é uma chamada extra à LLM. ANSWER_TIME_BUDGET (s) é o tempo total da
# pergunta: cada chamada recebe só o tempo que resta, e as voltas que não cabem são
# puladas, para não estourar o limite de ~100 s do Cloudflare (erro 524).
CHAOS_HALLUCINATION_CHANCES=15,50,50,75
CHAOS_HARNESS_ROUNDS=0,1,1,2
ANSWER_TIME_BUDGET=85
# Fuso da data e hora usadas na regra
CHAOS_TIMEZONE=America/Sao_Paulo

# Conexão DeepSeek criada automaticamente na subida da API (banco vazio + chave
# preenchida). Também dá para cadastrar pela tela, em Conectar LLM.
# Modelos: deepseek-chat (padrão) ou deepseek-reasoner
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_DEEPSEEK_API=
LLM_BASE_URL=https://api.deepseek.com

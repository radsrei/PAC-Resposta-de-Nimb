**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
env
nimb

# Segredos e dados nunca entram na imagem (vão por env_file e volumes)
backend/.env
backend/data
vector_store
deploy/.env
frontend/**/.env
frontend/**/.env.local

